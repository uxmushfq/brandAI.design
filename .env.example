# Copy to .env.local before running a production build.
#
# In development the session secret falls back to a fixed string so `npm run dev`
# works with no setup. `npm run start` refuses to boot without a real one, because
# a guessable secret means forgeable sessions.
SESSION_SECRET=change-me-to-something-long-and-random

# Used in the generated design.md, tokens.json and AI context so the links in them
# point at the real hub rather than the placeholder domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the file-backed store and uploaded assets live. Both default to .data/.
# Supabase replaces them; until then these are the whole database.
# BRANDAI_DATA_FILE=.data/db.json
# BRANDAI_UPLOAD_DIR=.data/uploads
